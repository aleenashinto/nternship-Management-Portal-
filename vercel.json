{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd portal && npm install",
  "buildCommand": "cd portal && npx prisma generate && npm run build",
  "outputDirectory": "portal/.next",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 9 * * *"
    }
  ]
}
